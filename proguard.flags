-keep class org.lineageos.settings.* {
  *;
}

# Instantiated reflectively by PhoneWindowManager (config_deviceKeyHandlerClasses)
-keep class org.lineageos.settings.pluskey.KeyHandler {
  <init>(android.content.Context);
}

# PocketKeyHandler is loaded the same way and uses PocketModeService's helpers.
-keep class org.lineageos.settings.pocket.** {
  *;
}
