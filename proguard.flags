-keep class org.lineageos.settings.* {
  *;
}

# PartsKeyHandler is instantiated reflectively by PhoneWindowManager
# (config_deviceKeyHandlerClasses) and loads these by name (config_partsKeyHandlers).
-keep class org.lineageos.settings.pluskey.KeyHandler {
  <init>(android.content.Context);
}

-keep class org.lineageos.settings.pocket.** {
  *;
}
