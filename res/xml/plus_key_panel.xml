<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/plus_key_title">

        <ListPreference
            android:key="config_plus_key_single_press"
            android:entries="@array/plus_key_action_entries"
            android:entryValues="@array/plus_key_action_entry_values"
            android:defaultValue="1"
            android:title="@string/plus_key_single_press_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            android:key="config_plus_key_long_press"
            android:entries="@array/plus_key_action_entries"
            android:entryValues="@array/plus_key_action_entry_values"
            android:defaultValue="-1"
            android:title="@string/plus_key_long_press_title"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/button_general_category_title">

        <SwitchPreferenceCompat
            android:key="config_vibration_feedback"
            android:title="@string/button_vibration_feedback_title"
            android:summary="@string/button_vibration_feedback_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

</PreferenceScreen>
